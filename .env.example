# Optional. Copy to .env before the first start.
# Each installation creates its own random password and MCP token.
OWNER_EMAIL=owner@example.com
PORT=17882

# Set only when serving through a reverse proxy or Cloudflare Tunnel.
# Use an origin without a path, e.g. https://tex.example.org
PUBLIC_URL=
# Trust only your actual proxy addresses; do not use true on an exposed server.
TRUST_PROXY=loopback
