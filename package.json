{
  "name": "paper-studio-mcp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "account": "node --env-file-if-exists=.env scripts/account.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "mcp": "node --env-file-if-exists=.env scripts/mcp-stdio.mjs",
    "test:integration": "node --env-file-if-exists=.env tests/live-mcp.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.3.0",
    "yazl": "^3.3.1",
    "yauzl": "^3.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "codemirror": "^6.0.2",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/view": "^6.39.0",
    "@codemirror/state": "^6.5.2",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "vite": "^7.3.1"
  },
  "license": "MIT",
  "description": "Self-hosted LaTeX editor with native MCP, revision-safe editing and isolated TeX compilation",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thuygom/paper-studio-mcp.git"
  }
}
